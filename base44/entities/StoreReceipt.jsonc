{
  "name": "StoreReceipt",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Apple",
        "Google"
      ]
    },
    "product_id": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string"
    },
    "original_transaction_id": {
      "type": "string"
    },
    "purchase_date": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending Verification",
        "Verified",
        "Invalid",
        "Refunded",
        "Expired"
      ],
      "default": "Pending Verification"
    },
    "verification_payload_hash": {
      "type": "string"
    },
    "last_verified_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "platform",
    "product_id",
    "transaction_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}