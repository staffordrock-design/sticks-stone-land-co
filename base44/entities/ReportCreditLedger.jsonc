{
  "name": "ReportCreditLedger",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "change": {
      "type": "number"
    },
    "balance_after": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "related_order_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "change"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}