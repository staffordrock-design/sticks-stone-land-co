{
  "name": "MarketplaceMessage",
  "type": "object",
  "properties": {
    "thread_key": {
      "type": "string"
    },
    "sender_user_id": {
      "type": "string"
    },
    "recipient_user_id": {
      "type": "string"
    },
    "deal_pipeline_id": {
      "type": "string"
    },
    "listing_id": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "sent_at": {
      "type": "string"
    },
    "read_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Sent",
        "Read",
        "Archived"
      ],
      "default": "Sent"
    }
  },
  "required": [
    "thread_key",
    "sender_user_id",
    "recipient_user_id",
    "message"
  ],
  "rls": {
    "create": {
      "data.sender_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.sender_user_id": "{{user.id}}"
        },
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}