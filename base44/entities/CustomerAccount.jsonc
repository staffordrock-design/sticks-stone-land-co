{
  "name": "CustomerAccount",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "Individual",
        "Professional",
        "Business",
        "Enterprise",
        "Seller"
      ],
      "default": "Individual"
    },
    "subscription_status": {
      "type": "string"
    },
    "lifetime_revenue": {
      "type": "number",
      "default": 0
    },
    "last_payment_at": {
      "type": "string"
    },
    "billing_notes": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_id",
    "email"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}