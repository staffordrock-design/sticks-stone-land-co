{
  "name": "DataRoomAccess",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string"
    },
    "listing_title": {
      "type": "string"
    },
    "network_opportunity_id": {
      "type": "string"
    },
    "data_room_request_id": {
      "type": "string"
    },
    "mining_site_id": {
      "type": "string"
    },
    "opportunity_owner_user_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "apple_transaction_id": {
      "type": "string"
    },
    "paid": {
      "type": "boolean",
      "default": true
    },
    "access_status": {
      "type": "string",
      "enum": [
        "Granted",
        "Revoked",
        "Expired"
      ],
      "default": "Granted"
    },
    "granted_at": {
      "type": "string"
    }
  },
  "required": [
    "listing_id",
    "paid"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.opportunity_owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}