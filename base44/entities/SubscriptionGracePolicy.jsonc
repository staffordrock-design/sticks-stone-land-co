{
  "name": "SubscriptionGracePolicy",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "Apple",
        "Google",
        "Web"
      ]
    },
    "plan_family": {
      "type": "string"
    },
    "grace_days": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Active"
      ],
      "default": "Draft"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "platform",
    "plan_family",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}