{
  "name": "SubscriptionRestoreAttempt",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Apple",
        "Google"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Requested",
        "Restored",
        "Nothing Found",
        "Failed"
      ],
      "default": "Requested"
    },
    "requested_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "platform",
    "status"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}