{
  "name": "UserBlock",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Additional details or notes about this record.",
      "maxLength": 1000
    },
    "blocker_user_id": {
      "type": "string"
    },
    "blocked_user_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "blocker_user_id",
    "blocked_user_id",
    "created_at"
  ],
  "rls": {
    "create": {
      "data.blocker_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.blocker_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.blocker_user_id": "{{user.id}}"
    },
    "delete": {
      "data.blocker_user_id": "{{user.id}}"
    }
  }
}
