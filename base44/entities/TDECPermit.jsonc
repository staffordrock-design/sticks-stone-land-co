{
  "name": "TDECPermit",
  "type": "object",
  "properties": {
    "permit_number": {
      "type": "string"
    },
    "permit_type": {
      "type": "string"
    },
    "facility_name": {
      "type": "string"
    },
    "permittee_name": {
      "type": "string",
      "description": "Legal permit holder/permittee shown by the controlling permit source."
    },
    "landowner_name": {
      "type": "string",
      "description": "Land/surface owner when the permit record expressly identifies one; assessor parcel ownership remains a separate source."
    },
    "operator_name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "default": "TN"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "msha_mine_id": {
      "type": "string"
    },
    "npdes_permit_number": {
      "type": "string"
    },
    "surface_mining_permit_number": {
      "type": "string"
    },
    "arap_permit_number": {
      "type": "string"
    },
    "permitted_acres": {
      "type": "number",
      "description": "Acreage stated by the controlling permit record. Do not substitute parcel acreage."
    },
    "acreage_basis": {
      "type": "string",
      "description": "Meaning of permitted_acres, such as NPDES permitted acreage or surface-mining disturbed acreage."
    },
    "acreage_source_url": {
      "type": "string"
    },
    "acreage_last_verified": {
      "type": "string"
    },
    "effective_date": {
      "type": "string"
    },
    "expiration_date": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "last_source_update": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "permit_number",
    "permit_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}