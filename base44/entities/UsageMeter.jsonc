{
  "name": "UsageMeter",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "metric": {
      "type": "string",
      "enum": [
        "Report Generated",
        "Export",
        "Data Room View",
        "Saved Opportunity",
        "Buyer Inquiry",
        "API Call"
      ]
    },
    "count": {
      "type": "number",
      "default": 0
    },
    "limit_value": {
      "type": "number"
    },
    "last_used_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "period",
    "metric"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}