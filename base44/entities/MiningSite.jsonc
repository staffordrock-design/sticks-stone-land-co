{
  "name": "MiningSite",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "MSHA",
        "TDEC",
        "County GIS",
        "Register of Deeds",
        "Other"
      ],
      "default": "MSHA"
    },
    "source_record_id": {
      "type": "string"
    },
    "msha_mine_id": {
      "type": "string"
    },
    "mine_name": {
      "type": "string"
    },
    "mine_status": {
      "type": "string"
    },
    "mine_type": {
      "type": "string"
    },
    "commodity": {
      "type": "string"
    },
    "operator_name": {
      "type": "string"
    },
    "permittee_name": {
      "type": "string",
      "description": "Named permit holder/permittee when verified from a regulatory permit record; kept separate from the MSHA operator."
    },
    "controller_name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "tdec_permit_number": {
      "type": "string"
    },
    "npdes_permit_number": {
      "type": "string"
    },
    "parcel_id": {
      "type": "string"
    },
    "parcel_owner": {
      "type": "string"
    },
    "acreage": {
      "type": "number",
      "description": "Parcel/tax-map acreage when available. This is not the same as permitted mining acreage."
    },
    "permitted_acres": {
      "type": "number",
      "description": "Acreage authorized or identified by the controlling mining/NPDES permit record. Never inferred from parcel acreage."
    },
    "permitted_acres_basis": {
      "type": "string",
      "description": "What the acreage represents, e.g. NPDES permitted acreage, surface-mining disturbed acreage, or permit-document acreage."
    },
    "permitted_acres_source_url": {
      "type": "string"
    },
    "permitted_acres_last_verified": {
      "type": "string"
    },
    "site_images": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "photo_condition_score": {
      "type": "number",
      "description": "Reviewed 0-100 visual/site-condition screening score derived from available property photos; not a reserve or engineering conclusion."
    },
    "photo_notes": {
      "type": "string"
    },
    "is_verified_listing": {
      "type": "boolean",
      "default": false
    },
    "listing_id": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "last_source_update": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "source",
    "mine_name",
    "state"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}