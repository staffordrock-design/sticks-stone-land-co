{
  "name": "PlanRecommendation",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "recommended_plan": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "dismissed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "recommended_plan"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}