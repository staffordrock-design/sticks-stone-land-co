{
  "name": "BuyerWatchlistDigest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "match_count": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Queued",
        "Sent",
        "Skipped"
      ],
      "default": "Queued"
    },
    "sent_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "period",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}