{
  "name": "SubscriptionCancellationRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "entitlement_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "requested_at": {
      "type": "string"
    },
    "effective_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Requested",
        "Scheduled",
        "Completed",
        "Cancelled"
      ],
      "default": "Requested"
    }
  },
  "required": [
    "user_id",
    "status"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}