{
  "name": "CompanyProfile",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "company_type": {
      "type": "string",
      "enum": [
        "Quarry Operator",
        "Aggregate Producer",
        "Landowner",
        "Contractor",
        "Supplier",
        "Engineering",
        "Geology",
        "Environmental",
        "Real Estate",
        "Investor",
        "Other"
      ]
    },
    "headline": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "states_served": {
      "type": "string"
    },
    "commodities": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "owner_user_id",
    "company_name",
    "company_type"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}