{
  "name": "FeatureRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "request": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Data",
        "Map",
        "Report",
        "Marketplace",
        "Billing",
        "Other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Reviewing",
        "Planned",
        "Done",
        "Declined"
      ],
      "default": "New"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "request",
    "status"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}