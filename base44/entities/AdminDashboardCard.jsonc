    },
    "card_code": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "source_entity": {
      "type": "string"
    },
    "metric_type": {
      "type": "string",
      "enum": [
        "Count",
        "Sum",
        "Average",
        "Status"
      ]
    },
    "filter_json": {
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "sort_order": {
      "type": "number"
    },
