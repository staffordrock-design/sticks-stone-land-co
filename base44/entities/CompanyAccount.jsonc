{
  "name": "CompanyAccount",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "billing_email": {
      "type": "string"
    },
    "plan_code": {
      "type": "string"
    },
    "seat_limit": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Trial",
        "Active",
        "Past Due",
        "Cancelled"
      ],
      "default": "Trial"
    },
    "created_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "owner_user_id",
    "company_name",
    "status"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}