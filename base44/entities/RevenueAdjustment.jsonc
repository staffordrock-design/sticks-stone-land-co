{
  "name": "RevenueAdjustment",
  "type": "object",
  "properties": {
    "adjustment_type": {
      "type": "string",
      "enum": [
        "Fee",
        "Tax",
        "Commission",
        "Credit",
        "Write-off",
        "Other"
      ]
    },
    "billing_event_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string"
    }
  },
  "required": [
    "adjustment_type",
    "amount"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}