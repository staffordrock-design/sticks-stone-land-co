{
  "name": "DataRoomRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "listing_id": {
      "type": "string"
    },
    "seller_submission_id": {
      "type": "string"
    },
    "network_opportunity_id": {
      "type": "string"
    },
    "mining_site_id": {
      "type": "string"
    },
    "opportunity_title": {
      "type": "string"
    },
    "opportunity_owner_user_id": {
      "type": "string"
    },
    "buyer_company": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "nda_agreed": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "Requested",
        "Qualification Review",
        "NDA Required",
        "Approved",
        "Declined",
        "Expired"
      ],
      "default": "Requested"
    },
    "requested_at": {
      "type": "string"
    },
    "decided_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "listing_id",
    "status"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.opportunity_owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.opportunity_owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}