{
  "name": "PriorityParcelEnrichmentQueue",
  "type": "object",
  "properties": {
    "mining_site_id": {
      "type": "string"
    },
    "mine_name": {
      "type": "string"
    },
    "msha_mine_id": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Queued",
        "Retrying",
        "Matched",
        "No Match",
        "Service Timeout"
      ],
      "default": "Queued"
    },
    "attempts": {
      "type": "number",
      "default": 0
    },
    "last_attempt_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "mining_site_id",
    "mine_name",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}