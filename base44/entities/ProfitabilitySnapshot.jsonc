{
  "name": "ProfitabilitySnapshot",
  "type": "object",
  "properties": {
    "period": {
      "type": "string"
    },
    "gross_revenue": {
      "type": "number"
    },
    "platform_fees": {
      "type": "number"
    },
    "direct_costs": {
      "type": "number"
    },
    "net_contribution": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "period"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}