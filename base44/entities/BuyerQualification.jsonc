{
  "name": "BuyerQualification",
  "type": "object",
  "properties": {
    "buyer_user_id": {
      "type": "string"
    },
    "buyer_profile_id": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "qualification_status": {
      "type": "string",
      "enum": [
        "Unreviewed",
        "Pending",
        "Qualified",
        "Restricted",
        "Declined"
      ],
      "default": "Unreviewed"
    },
    "funding_evidence_status": {
      "type": "string",
      "enum": [
        "Not Requested",
        "Requested",
        "Received",
        "Reviewed"
      ],
      "default": "Not Requested"
    },
    "nda_eligible": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    }
  },
  "required": [
    "buyer_user_id",
    "qualification_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.buyer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}