{
  "name": "NDAAgreement",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Additional details or notes about this record.",
      "maxLength": 1000
    },
    "listing_id": {
      "type": "string"
    },
    "listing_title": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "agreed": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "listing_id",
    "user_id",
    "agreed"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
