{
  "name": "BuyerMatchEvent",
  "type": "object",
  "properties": {
    "buyer_user_id": {
      "type": "string"
    },
    "buyer_profile_id": {
      "type": "string"
    },
    "listing_id": {
      "type": "string"
    },
    "seller_submission_id": {
      "type": "string"
    },
    "match_score": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "notified_at": {
      "type": "string"
    },
    "opened_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Matched",
        "Notified",
        "Viewed",
        "Saved",
        "Interested",
        "Passed"
      ],
      "default": "Matched"
    }
  },
  "required": [
    "buyer_user_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.buyer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}