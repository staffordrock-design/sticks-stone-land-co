{
  "name": "CompanyWatch",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "relationship_type": {
      "type": "string",
      "enum": [
        "Operator",
        "Controller",
        "Landowner",
        "Any"
      ],
      "default": "Any"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "company_name",
    "created_at"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}