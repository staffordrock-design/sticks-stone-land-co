{
  "name": "SavedOpportunity",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "listing_id": {
      "type": "string"
    },
    "mining_site_id": {
      "type": "string"
    },
    "resource_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "saved_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "resource_name"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}