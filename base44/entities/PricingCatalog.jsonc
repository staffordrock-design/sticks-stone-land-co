{
  "name": "PricingCatalog",
  "type": "object",
  "properties": {
    "product_code": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Subscription",
        "Seller Package",
        "Report",
        "Data Room"
      ]
    },
    "billing_period": {
      "type": "string",
      "enum": [
        "Monthly",
        "Annual",
        "One Time",
        "Custom"
      ]
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Active",
        "Retired"
      ],
      "default": "Draft"
    },
    "apple_product_id": {
      "type": "string"
    },
    "google_product_id": {
      "type": "string"
    },
    "stripe_price_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "features": {
      "type": "string"
    }
  },
  "required": [
    "product_code",
    "product_name",
    "category",
    "billing_period",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}