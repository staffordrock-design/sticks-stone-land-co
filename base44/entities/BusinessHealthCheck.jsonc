      "enum": [
        "Billing",
        "Store",
        "Marketplace",
        "Reports",
        "Deals",
        "Security",
        "Data"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Green",
        "Yellow",
        "Red"
      ]
    },
    "summary": {
      "type": "string"
    },
    "checked_at": {
      "type": "string"
    }
  },
  "required": [
    "area",
    "status",
    "summary"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
