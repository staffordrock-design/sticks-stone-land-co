{
  "name": "BillingPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "billing_email": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "purchase_order_required": {
      "type": "boolean",
      "default": false
    },
    "purchase_order_number": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}