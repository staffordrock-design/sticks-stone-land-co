{
  "name": "SellerDocument",
  "type": "object",
  "properties": {
    "seller_submission_id": {
      "type": "string"
    },
    "listing_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "document_name": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "Survey",
        "Core Log",
        "Reserve Study",
        "Environmental",
        "Permit",
        "Production",
        "Lease",
        "Royalty",
        "Title",
        "Equipment",
        "Financial",
        "Other"
      ]
    },
    "confidential": {
      "type": "boolean",
      "default": true
    },
    "file_url": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "uploaded_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Uploaded",
        "Reviewed",
        "Approved",
        "Rejected"
      ],
      "default": "Uploaded"
    }
  },
  "required": [
    "owner_user_id",
    "document_name",
    "document_type",
    "status"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}