{
  "name": "DataRoomDocumentGrant",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Additional details or notes about this record.",
      "maxLength": 1000
    },
    "data_room_access_id": {
      "type": "string"
    },
    "seller_document_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "granted": {
      "type": "boolean",
      "default": true
    },
    "granted_at": {
      "type": "string"
    },
    "revoked_at": {
      "type": "string"
    }
  },
  "required": [
    "data_room_access_id",
    "seller_document_id",
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
