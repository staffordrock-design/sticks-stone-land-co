{
  "name": "OfferEvent",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Additional details or notes about this record.",
      "maxLength": 1000
    },
    "deal_interest_id": {
      "type": "string"
    },
    "deal_pipeline_id": {
      "type": "string"
    },
    "buyer_user_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "Submitted",
        "Revised",
        "Countered",
        "Accepted",
        "Declined",
        "Withdrawn"
      ]
    },
    "amount": {
      "type": "number"
    },
    "terms_summary": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string"
    }
  },
  "required": [
    "event_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.buyer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
