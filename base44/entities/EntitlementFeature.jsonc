{
  "name": "EntitlementFeature",
  "type": "object",
  "properties": {
    "plan_code": {
      "type": "string"
    },
    "feature_code": {
      "type": "string"
    },
    "feature_name": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "limit_value": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "plan_code",
    "feature_code",
    "feature_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}