{
  "name": "OwnerActionQueue",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Pricing",
        "Store",
        "Legal",
        "Operations"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "High",
        "Normal",
        "Low"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Done",
        "Deferred"
      ],
      "default": "Open"
    },
    "why_it_matters": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category",
    "priority",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}