{
  "name": "DataExportJob",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "export_type": {
      "type": "string",
      "enum": [
        "Saved Opportunities",
        "Quarry Intelligence",
        "Deal Data",
        "Custom"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Requested",
        "Processing",
        "Ready",
        "Expired",
        "Failed"
      ],
      "default": "Requested"
    },
    "requested_at": {
      "type": "string"
    },
    "ready_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "export_type",
    "status"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}