{
  "name": "WebPaymentSession",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "Seller Package",
        "Report",
        "Data Room",
        "Other"
      ]
    },
    "related_entity_id": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "Created",
        "Open",
        "Paid",
        "Expired",
        "Failed"
      ],
      "default": "Created"
    },
    "created_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "purpose",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}