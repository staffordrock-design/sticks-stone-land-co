{
  "name": "NetworkComment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string"
    },
    "author_user_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Published",
        "Hidden",
        "Removed"
      ],
      "default": "Published"
    }
  },
  "required": [
    "post_id",
    "author_user_id",
    "body",
    "created_at",
    "status"
  ],
  "rls": {
    "create": {
      "data.author_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.author_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.author_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}