{
  "name": "SubscriptionBenefitUsage",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "entitlement_id": {
      "type": "string"
    },
    "benefit_code": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "used": {
      "type": "number",
      "default": 0
    },
    "included": {
      "type": "number"
    },
    "overage": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id",
    "benefit_code",
    "period"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}