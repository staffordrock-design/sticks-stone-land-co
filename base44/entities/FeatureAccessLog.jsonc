{
  "name": "FeatureAccessLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "feature_code": {
      "type": "string"
    },
    "allowed": {
      "type": "boolean"
    },
    "plan_code": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "feature_code",
    "allowed"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}