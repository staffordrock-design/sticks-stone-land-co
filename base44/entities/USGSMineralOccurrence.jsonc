{
  "name": "USGSMineralOccurrence",
  "type": "object",
  "properties": {
    "mining_site_id": {
      "type": "string",
      "description": "Linked MiningSite record ID. Null for unmatched potential/historical occurrences."
    },
    "msha_mine_id": {
      "type": "string"
    },
    "mrds_id": {
      "type": "string",
      "description": "USGS MRDS record ID (dep_id)"
    },
    "occurrence_name": {
      "type": "string"
    },
    "commodity": {
      "type": "string"
    },
    "commodity_list": {
      "type": "string"
    },
    "commodity_codes": {
      "type": "string",
      "description": "Raw USGS MRDS code_list field (e.g., 'LST SDG SIL')"
    },
    "mineralogy": {
      "type": "string",
      "description": "Ore / gangue minerals listed in the MRDS record"
    },
    "deposit_type": {
      "type": "string"
    },
    "development_status": {
      "type": "string"
    },
    "operation_type": {
      "type": "string"
    },
    "geologic_model": {
      "type": "string"
    },
    "host_rock": {
      "type": "string"
    },
    "associated_rock": {
      "type": "string"
    },
    "production_size": {
      "type": "string"
    },
    "discovery_year": {
      "type": "string"
    },
    "record_type": {
      "type": "string"
    },
    "mine_method": {
      "type": "string"
    },
    "deposit_size": {
      "type": "string"
    },
    "significant": {
      "type": "string"
    },
    "commodity_type": {
      "type": "string"
    },
    "land_status": {
      "type": "string"
    },
    "physiographic_division": {
      "type": "string"
    },
    "physiographic_province": {
      "type": "string"
    },
    "physiographic_section": {
      "type": "string"
    },
    "elevation_m": {
      "type": "number"
    },
    "point_reference": {
      "type": "string"
    },
    "alternate_names": {
      "type": "string"
    },
    "references": {
      "type": "string"
    },
    "source_database": {
      "type": "string"
    },
    "usgs_record_updated": {
      "type": "string"
    },
    "raw_usgs_json": {
      "type": "string",
      "description": "Compact official USGS MRDS source snapshot preserved for traceability; full live record remains linked by source_url"
    },
    "occurrence_state": {
      "type": "string",
      "description": "Two-letter state code used by S&S, e.g. TN"
    },
    "occurrence_state_name": {
      "type": "string",
      "description": "State/province name published by USGS"
    },
    "occurrence_county": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "distance_meters": {
      "type": "number",
      "description": "Distance from the linked mining site to the MRDS occurrence point"
    },
    "match_status": {
      "type": "string",
      "enum": [
        "matched",
        "nearby",
        "unmatched",
        "historical"
      ],
      "default": "unmatched",
      "description": "How this USGS occurrence relates to the S&S MiningSite inventory: matched = linked to a specific mine, nearby = close but not linked, unmatched = standalone potential/historical deposit, historical = past producer with no current mine link"
    },
    "match_method": {
      "type": "string",
      "description": "How the match was determined: coordinate, name, cross_reference, proximity"
    },
    "source_url": {
      "type": "string"
    },
    "last_source_update": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "mrds_id",
    "occurrence_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}