{
  "name": "USGSMineralOccurrence",
  "type": "object",
  "properties": {
    "mining_site_id": {
      "type": "string"
    },
    "msha_mine_id": {
      "type": "string"
    },
    "mrds_id": {
      "type": "string",
      "description": "USGS MRDS record ID (dep_id)"
    },
    "occurrence_name": {
      "type": "string"
    },
    "commodity": {
      "type": "string"
    },
    "commodity_list": {
      "type": "string"
    },
    "mineralogy": {
      "type": "string",
      "description": "Ore / gangue minerals listed in the MRDS record"
    },
    "deposit_type": {
      "type": "string"
    },
    "development_status": {
      "type": "string"
    },
    "operation_type": {
      "type": "string"
    },
    "geologic_model": {
      "type": "string"
    },
    "host_rock": {
      "type": "string"
    },
    "associated_rock": {
      "type": "string"
    },
    "production_size": {
      "type": "string"
    },
    "discovery_year": {
      "type": "string"
    },
    "record_type": {
      "type": "string"
    },
    "mine_method": {
      "type": "string"
    },
    "deposit_size": {
      "type": "string"
    },
    "significant": {
      "type": "string"
    },
    "commodity_type": {
      "type": "string"
    },
    "land_status": {
      "type": "string"
    },
    "physiographic_division": {
      "type": "string"
    },
    "physiographic_province": {
      "type": "string"
    },
    "physiographic_section": {
      "type": "string"
    },
    "elevation_m": {
      "type": "number"
    },
    "point_reference": {
      "type": "string"
    },
    "alternate_names": {
      "type": "string"
    },
    "references": {
      "type": "string"
    },
    "source_database": {
      "type": "string"
    },
    "usgs_record_updated": {
      "type": "string"
    },
    "raw_usgs_json": {
      "type": "string",
      "description": "Raw USGS MRDS JSON response preserved for traceability"
    },
    "occurrence_state": {
      "type": "string",
      "description": "Two-letter state code used by S&S, e.g. TN"
    },
    "occurrence_state_name": {
      "type": "string",
      "description": "State/province name published by USGS"
    },
    "occurrence_county": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "distance_meters": {
      "type": "number",
      "description": "Distance from the linked mining site to the MRDS occurrence point"
    },
    "source_url": {
      "type": "string"
    },
    "last_source_update": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "mining_site_id",
    "mrds_id",
    "occurrence_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}