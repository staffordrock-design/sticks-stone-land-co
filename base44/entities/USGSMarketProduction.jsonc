    },
    "period": {
      "type": "string"
    },
    "quantity_metric_tons": {
      "type": "number"
    },
    "percent_change_yoy": {
      "type": "number"
    },
    "prior_year_annual_quantity_metric_tons": {
      "type": "number"
    },
    "prior_year_annual_value_usd": {
      "type": "number"
    },
    "source_title": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "publication_date": {
      "type": "string"
    },
    "methodology_note": {
      "type": "string"
    },
    "last_source_update": {
      "type": "string"
    }
  },
  "required": [
    "state",
    "commodity_group",
    "year",
    "period",
    "quantity_metric_tons",
    "source_title",
    "source_url"
  ],
  "rls": {
