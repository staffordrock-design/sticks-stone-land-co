{
  "name": "AccountActivitySummary",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "site_views": {
      "type": "number",
      "default": 0
    },
    "saved_opportunities": {
      "type": "number",
      "default": 0
    },
    "buyer_inquiries": {
      "type": "number",
      "default": 0
    },
    "report_orders": {
      "type": "number",
      "default": 0
    },
    "data_room_views": {
      "type": "number",
      "default": 0
    },
    "last_active_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "period"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}