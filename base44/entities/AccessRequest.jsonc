{
  "name": "AccessRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "listing_id": {
      "type": "string"
    },
    "access_type": {
      "type": "string",
      "enum": [
        "Seller Data Room",
        "Enhanced Report",
        "Export",
        "Enterprise Feature"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Requested",
        "Approved",
        "Declined",
        "Expired"
      ],
      "default": "Requested"
    },
    "requested_at": {
      "type": "string"
    },
    "decided_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "access_type",
    "status"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}