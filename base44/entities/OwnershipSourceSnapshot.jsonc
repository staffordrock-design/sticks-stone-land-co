{
  "name": "OwnershipSourceSnapshot",
  "type": "object",
  "properties": {
    "mining_site_id": {
      "type": "string"
    },
    "msha_mine_id": {
      "type": "string"
    },
    "parcel_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_name_2": {
      "type": "string"
    },
    "property_address": {
      "type": "string"
    },
    "mailing_address": {
      "type": "string"
    },
    "tax_year": {
      "type": "number"
    },
    "deed_book_page": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_updated": {
      "type": "string"
    },
    "verified_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Verified from Assessment GIS",
        "Parcel Matched - Owner Unavailable",
        "No Parcel Match",
        "No Coordinates"
      ],
      "default": "Verified from Assessment GIS"
    }
  },
  "required": [
    "mining_site_id",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}