{
  "name": "SubscriptionFeatureGrant",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "feature_code": {
      "type": "string"
    },
    "source_entitlement_id": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "limit_value": {
      "type": "number"
    },
    "expires_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "feature_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}