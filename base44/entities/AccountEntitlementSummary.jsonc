{
  "name": "AccountEntitlementSummary",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "plan_family": {
      "type": "string"
    },
    "plan_code": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "seat_role": {
      "type": "string"
    },
    "report_credits": {
      "type": "number"
    },
    "expires_at": {
      "type": "string"
    },
    "last_recalculated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}