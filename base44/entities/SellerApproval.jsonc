{
  "name": "SellerApproval",
  "type": "object",
  "properties": {
    "seller_submission_id": {
      "type": "string"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Identity Check",
        "Ownership Review",
        "Approved",
        "Needs Info",
        "Declined"
      ],
      "default": "Pending"
    },
    "ownership_evidence_status": {
      "type": "string",
      "enum": [
        "Not Provided",
        "Provided",
        "Reviewed"
      ],
      "default": "Not Provided"
    },
    "reviewed_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "seller_submission_id",
    "review_status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}