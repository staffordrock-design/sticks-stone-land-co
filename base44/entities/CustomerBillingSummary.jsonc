{
  "name": "CustomerBillingSummary",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "No Billing",
        "Current",
        "Past Due",
        "Cancelled"
      ],
      "default": "No Billing"
    },
    "current_plan": {
      "type": "string"
    },
    "next_renewal_at": {
      "type": "string"
    },
    "last_payment_amount": {
      "type": "number"
    },
    "last_payment_at": {
      "type": "string"
    },
    "open_balance": {
      "type": "number",
      "default": 0
    },
    "open_issues": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}