{
  "name": "MarketplaceAccountRole",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "Buyer",
        "Seller",
        "Professional",
        "Company Admin",
        "Company Member"
      ]
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "assigned_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}